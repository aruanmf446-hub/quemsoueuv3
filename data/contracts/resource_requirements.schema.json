{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "proposal_not_loaded_by_game"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "kind": {
            "enum": [
              "character",
              "environment",
              "effects",
              "ui",
              "audio",
              "narrative"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "availability": {
            "enum": [
              "available_unverified",
              "missing",
              "planned"
            ]
          },
          "existing_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^res://[^\\\\]+$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "kind",
          "description",
          "availability",
          "existing_files"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "status",
    "resources"
  ],
  "additionalProperties": false
}
